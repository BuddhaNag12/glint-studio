COMFYUI_URL=http://127.0.0.1:8188
API_KEY=replace-with-a-strong-random-token
URL_SIGNING_SECRET=
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
PUBLIC_BASE_URL=http://127.0.0.1:8000
REQUEST_TIMEOUT_SECONDS=120
MAX_CONCURRENT_JOBS=1
# Longest a local job waits for a free slot before failing with `timeout`
QUEUE_TIMEOUT_SECONDS=600
OUTPUT_DIR=./generated_images
WORKFLOWS_DIR=./workflows
# Your own style presets (*.json); same id as a built-in replaces it
USER_STYLES_DIR=
# Remote image APIs (see providers.example.json); put their keys below, e.g. OPENAI_API_KEY=
PROVIDERS_FILE=
SIGN_IMAGE_URLS=true
IMAGE_URL_TTL_SECONDS=3600
CLEAR_COMFY_HISTORY=true
CLEANUP_COMFY_FILES=true
COMFYUI_DIR=
COMFYUI_TEMP_DIR=
COMFYUI_OUTPUT_DIR=
# Tunnel launcher options for start-comfy-bridge.bat / start-comfy-bridge.command
# TUNNEL_PROVIDER: auto | cloudflare | tailscale | ngrok | none
TUNNEL_PROVIDER=auto
# Cloudflare named tunnel (optional; omit both for quick trycloudflare.com URL)
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_NAME=
# ngrok static free domain (optional; e.g. my-name.ngrok-free.app)
NGROK_DOMAIN=
